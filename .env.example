# Copie este arquivo para .env e ajuste os valores.
# Nunca commite o arquivo .env.

# MySQL (Docker Compose — Etapa 1)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# JWT — ainda não usado (entra na etapa de autenticação).
# Gere uma string longa e aleatória (mínimo 32 caracteres / 256 bits para HS256).
JWT_SECRET=altere-para-uma-string-longa-e-aleatoria

# Backend
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
